class Solution {
    public String smallestPalindrome(String s) {
        int n = s.length();
        int[] count = new int[26];

        char[] ch = s.toCharArray();
        for (int i = 0; i < n / 2; i++) {
            count[ch[i] - 'a']++;
        }

        int idx = 0;
        for (int i = 0; i < 26; i++) {
            while (count[i]-- > 0) {
                ch[idx++] = (char) ('a' + i);
            }
        }

        for (int i = 0; i < n / 2; i++) {
            ch[n - 1 - i] = ch[i];
        }

        return new String(ch);
    }
}
